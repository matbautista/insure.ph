# Committed, non-secret defaults for the public/sales demo environment.
# Override secrets in .env.demo.local (gitignored, never committed) or,
# in CI/CD, via the hosting provider's secret store for the "demo" environment.
#
# Demo is customer-facing but uses seeded/reset-able sample data — treat it
# as public, not as containing real user data.

NEXT_PUBLIC_APP_ENV=demo
NEXT_PUBLIC_APP_ENV_LABEL=Demo
NEXT_PUBLIC_APP_URL=https://demo.insure-ph.example.com
NEXT_PUBLIC_API_URL=https://demo.insure-ph.example.com/api

ALLOW_TEST_ENDPOINTS=true
