# Committed, non-secret defaults for production.
# Real secrets MUST come from the hosting provider's secret store for the
# "production" environment — never from a .local file on a laptop.

NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_ENV_LABEL=Production
NEXT_PUBLIC_APP_URL=https://www.insure-ph.example.com
NEXT_PUBLIC_API_URL=https://www.insure-ph.example.com/api

ALLOW_TEST_ENDPOINTS=false
