# Copy this file to .env.<environment>.local for local overrides.
# Never commit real secrets — only .env.example and the non-secret
# .env.<environment> defaults files are tracked in git.

# Which environment this build/run represents.
# One of: demo | development | staging | production
NEXT_PUBLIC_APP_ENV=development

# Public, human-readable name shown in UI (e.g. a "DEMO" badge).
NEXT_PUBLIC_APP_ENV_LABEL=Development

# Base URL of this deployment (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL of the API this environment talks to. Same as APP_URL when
# using Next.js API routes / route handlers in-process.
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# --- Server-only secrets (never prefixed with NEXT_PUBLIC_) ---

# Database connection string. Provisioned via Neon (neon.tech) — create one
# branch per environment (demo/development/staging/production) within a
# single Neon project, mirroring the git branches. Use each branch's
# connection string here. Required for /api/inquiries to save submissions.
DATABASE_URL=postgresql://user:password@localhost:5432/insure_ph_dev

# Resend (resend.com) API key. Required for /api/inquiries to email new
# leads to info@insureph.org. Without it, submissions still save to the
# database, just without the notification email.
RESEND_API_KEY=re_replace_me

# "From" address for inquiry notification emails. Must be on a domain
# verified in Resend; falls back to Resend's shared test address if unset
# (fine for local dev, not for demo/staging/production).
INQUIRY_FROM_EMAIL=Insure PH <onboarding@resend.dev>

# Session/auth signing secret. Generate a unique value per environment,
# e.g. `openssl rand -base64 32`.
AUTH_SECRET=replace-me

# Bcrypt hash of the /admin dashboard password. Generate with:
# node -e "require('bcryptjs').hash(process.argv[1], 10).then(console.log)" 'your-password'
# Never put the plaintext password itself in an env var.
ADMIN_PASSWORD_HASH=replace-me

# Feature flag: allow destructive/test-only endpoints (seed/reset data).
# Should be "true" only in demo and development.
ALLOW_TEST_ENDPOINTS=true
