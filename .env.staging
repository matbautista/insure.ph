# Committed, non-secret defaults for staging (pre-production, prod-like).
# Override secrets in .env.staging.local (gitignored, never committed) or,
# in CI/CD, via the hosting provider's secret store for the "staging" environment.

NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_APP_ENV_LABEL=Staging
NEXT_PUBLIC_APP_URL=https://staging.insure-ph.example.com
NEXT_PUBLIC_API_URL=https://staging.insure-ph.example.com/api

ALLOW_TEST_ENDPOINTS=false
