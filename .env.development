# Committed, non-secret defaults for local development.
# Override secrets in .env.development.local (gitignored, never committed).

NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_ENV_LABEL=Development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

ALLOW_TEST_ENDPOINTS=true
