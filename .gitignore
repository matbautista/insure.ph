# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - only *.local files and a bare .env are ignored; the
# per-environment defaults (.env.demo, .env.development, .env.staging,
# .env.production, .env.example) are intentionally committed (see
# ENVIRONMENTS.md). Never put real secrets in the committed files.
.env
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*
